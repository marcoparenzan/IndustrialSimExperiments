<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- PySharpMachineLib pulls PySharp.Interpreter from here (published by the PySharp repo's
         own `dotnet pack ... -o D:\Dev\NuGetLocalFeed` workflow, not on nuget.org). -->
    <add key="PySharpLocalFeed" value="D:\Dev\NuGetLocalFeed" />
  </packageSources>
</configuration>
