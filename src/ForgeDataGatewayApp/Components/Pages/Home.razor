@page "/"
@inject GatewayService Gateway

<PageTitle>ForgeDataGateway</PageTitle>

<h1 class="text-2xl font-semibold text-white">Overview</h1>
<p class="mt-1 text-sm text-slate-400">Poll OPC UA sources, buffer samples in memory, and publish them to MQTT as a Unified Namespace.</p>

<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card">
        <div class="field-label">Status</div>
        <div class="mt-1 flex items-center gap-2 text-xl font-semibold @(Gateway.IsRunning ? "text-emerald-400" : "text-slate-400")">
            <span class="inline-block h-2.5 w-2.5 rounded-full @(Gateway.IsRunning ? "bg-emerald-400" : "bg-slate-600")"></span>
            @(Gateway.IsRunning ? "Running" : "Stopped")
        </div>
    </div>
    <div class="card">
        <div class="field-label">Sources</div>
        <div class="mt-1 text-xl font-semibold text-white">@Gateway.Config.Sources.Count(s => s.Enabled) <span class="text-sm font-normal text-slate-500">/ @Gateway.Config.Sources.Count</span></div>
    </div>
    <div class="card">
        <div class="field-label">Tags</div>
        <div class="mt-1 text-xl font-semibold text-white">@Gateway.Config.Tags.Count(t => t.Enabled) <span class="text-sm font-normal text-slate-500">/ @Gateway.Config.Tags.Count</span></div>
    </div>
    <div class="card">
        <div class="field-label">MQTT broker</div>
        <div class="mt-1 text-xl font-semibold text-white">@Gateway.Config.Mqtt.Host:@Gateway.Config.Mqtt.Port</div>
    </div>
</div>

<div class="mt-6 flex gap-3">
    @if (Gateway.IsRunning)
    {
        <button class="btn-danger" @onclick="StopAsync" disabled="@busy">Stop</button>
    }
    else
    {
        <button class="btn" @onclick="StartAsync" disabled="@busy">Start</button>
    }
    <a href="/tags" class="btn-secondary">View live values</a>
</div>

@code {
    private bool busy;

    private async Task StartAsync()
    {
        busy = true;
        await Gateway.StartAsync();
        busy = false;
    }

    private async Task StopAsync()
    {
        busy = true;
        await Gateway.StopAsync();
        busy = false;
    }
}
