@inherits LayoutComponentBase
@inject GatewayService Gateway

<div class="flex h-screen bg-slate-950 text-slate-200">
    <nav class="flex w-56 flex-none flex-col border-r border-slate-800 bg-slate-900">
        <div class="px-5 py-6">
            <div class="text-lg font-semibold text-white">ForgeDataGateway</div>
            <div class="mt-1 flex items-center gap-2 text-xs">
                <span class="inline-block h-2 w-2 rounded-full @(Gateway.IsRunning ? "bg-emerald-400" : "bg-slate-600")"></span>
                <span class="text-slate-400">@(Gateway.IsRunning ? "Running" : "Stopped")</span>
            </div>
        </div>
        <div class="flex flex-col gap-1 px-3">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link">Home</NavLink>
            <NavLink href="sources" class="nav-link">Sources</NavLink>
            <NavLink href="browse" class="nav-link">Browse</NavLink>
            <NavLink href="tags" class="nav-link">Tags</NavLink>
            <NavLink href="namespace" class="nav-link">Namespace &amp; MQTT</NavLink>
        </div>
    </nav>

    <main class="flex-1 overflow-y-auto">
        <div class="mx-auto max-w-6xl px-8 py-8">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
