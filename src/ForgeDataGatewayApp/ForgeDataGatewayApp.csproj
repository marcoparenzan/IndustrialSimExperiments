<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <TailwindExtraArgs Condition="'$(Configuration)' == 'Release'">--minify</TailwindExtraArgs>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeDataGatewayCore\ForgeDataGatewayCore.csproj" />
  </ItemGroup>

  <!--
    Compiles Styles/tailwind.css -> wwwroot/css/tailwind.css using Tailwind's standalone CLI binary
    (no Node/npm). The binary is a downloaded platform executable, not a NuGet package, so it is not
    committed to git (see FORGE-DATA-GATEWAY.md for the one-time setup step); this target skips with
    a warning instead of failing the build when it's missing.
  -->
  <Target Name="TailwindBuild" BeforeTargets="Build">
    <Warning Text="tools/tailwindcss.exe not found - skipping Tailwind CSS build. See FORGE-DATA-GATEWAY.md for setup."
             Condition="!Exists('$(MSBuildProjectDirectory)/tools/tailwindcss.exe')" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)/tools/tailwindcss.exe&quot; -i &quot;$(MSBuildProjectDirectory)/Styles/tailwind.css&quot; -o &quot;$(MSBuildProjectDirectory)/wwwroot/css/tailwind.css&quot; $(TailwindExtraArgs)"
          Condition="Exists('$(MSBuildProjectDirectory)/tools/tailwindcss.exe')" />
  </Target>

</Project>
